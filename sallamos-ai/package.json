{
  "name":"sallamos-ai","version":"1.2.0","private":true,"type":"module",
  "scripts":{"dev":"wrangler dev --env stage","typecheck":"tsc -p tsconfig.json","validate":"npm run typecheck && npm run evals:candidates && wrangler deploy --dry-run --env stage && wrangler deploy --dry-run --env production","preflight:stage":"node scripts/preflight.mjs stage","preflight:production":"node scripts/preflight.mjs production","provision:stage":"node scripts/provision.mjs stage","provision:production":"node scripts/provision.mjs production","sync:stage":"node scripts/sync-sallamos-api.mjs --env stage","sync:production":"node scripts/sync-sallamos-api.mjs --env production","smoke":"node scripts/smoke.mjs","evals":"node evals/runner.mjs","evals:ready":"node scripts/validate-eval-readiness.mjs","evals:candidates":"node scripts/validate-eval-candidates.mjs"},
  "devDependencies":{"typescript":"^5.6.0","wrangler":"^4.68.0"}
}
