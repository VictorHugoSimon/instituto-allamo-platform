{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sallamos-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "META", "database_name": "sallamos-ai-meta", "database_id": "PREENCHER" }
  ],
  "vectorize": [
    { "binding": "VEC", "index_name": "sallamos-docs" }
  ],
  "r2_buckets": [
    { "binding": "SOURCES", "bucket_name": "sallamos-ai-sources" }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "ANSWER_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "PROMPT_VERSION": "v1.1",
    "CONFIDENCE_ANSWER": "0.75",
    "CONFIDENCE_CLARIFY": "0.50",
    "DEMO_MODE": "true",
    "SALLAMOS_API_BASE": ""
  }
}
